          "line": 2,
          "text": "import {createHellRouteGearV15} from './hell-route-gear-v15.js';",
          "truncated": false
        },
        {
          "line": 3,
          "text": "export function gearBudgetV17(cls,lv,slot,rarity){",
          "truncated": false
        },
        {
          "line": 4,
          "text": " const power=QUALITIES[rarity]?.power||1,primary={shadow:'dex',oath:'str',ember:'wis',saint:'wis'}[cls]||'vit',late=Math.max(0,Math.min(32,lv)-6);",
          "truncated": false
        },
        {
          "line": 5,
          "text": " return {gearGrowthVersion:17,attrs:power>1?{[primary]:Math.ceil((power-1)*(1+Math.max(0,Math.min(32,lv)-5)*.25)),...(power>=4?{vit:Math.ceil((power-2)*(1+Math.max(0,Math.min(32,lv)-5)*.12))}:{})}:{},",
          "truncated": false
        },
        {
          "line": 6,
          "text": "  atk:slot==='weapon'||slot==='offhand'?lv+power*2+Math.ceil(late*(power-1)*.33):slot==='hands'||slot==='relic'?power+Math.ceil(late*(power-1)*.1):0,",
          "truncated": false
        },
        {
          "line": 7,
          "text": "  hp:(slot==='chest'?12+power*9:slot==='head'?power*6:slot==='feet'||slot==='relic'?power*4:0)+(late>0&&['chest','head','feet','relic'].includes(slot)?Math.ceil(late*power*(slot==='chest'?.8:.3)):0)};",
          "truncated": false
        },
        {
          "line": 8,
          "text": "}",
          "truncated": false
        }
      ],
      "full_file_bytes": 7162
