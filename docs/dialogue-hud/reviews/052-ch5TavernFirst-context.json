  "before": [
    [
      "瑟琳娜",
      "两位，别站门口吹风了，进来坐吧。"
    ],
    [
      "艾莉娅",
      "这里的食物，活人吃了也没事吗？"
    ],
    [
      "瑟琳娜",
      "当然能。只是尝不尝得出味道，要看你还是不是活人。"
    ],
    [
      "诺恩",
      "来点热的，不放酒。"
    ],
    [
      "瑟琳娜",
      "好。姑娘呢，你想喝什么？"
    ],
    [
      "艾莉娅",
      "有不苦的吗？"
    ],
    [
      "瑟琳娜",
      "甜枣花露怎么样？也有暖喉的薄酒，看你喜欢。"
    ],
    [
      "艾莉娅",
      "花露吧。我还要看着他换药。"
    ],
    [
      "诺恩",
      "我能自己换。"
    ],
    [
      "瑟琳娜",
      "那就两杯花露。换药的事待会儿再商量，先喝点热的。"
    ]
  ],
