  "screens": [
    {
      "width": 1440,
      "id": "c1TrialInvitation",
      "line": 9,
      "text": "找鲁恩吧，试炼的事他会帮你安排。",
      "speaker": "薇蕾娜",
      "overflow": false
    },
    {
      "width": 1440,
      "id": "c1Talk_c1Readiness_report",
      "line": 1,
      "text": "身手不错嘛。可以去找伊登做进阶试炼了，地下的哨兵带着盾，可比这些家伙难对付。",
      "speaker": "鲁恩",
      "overflow": false
    },
    {
      "width": 1440,
      "id": "sisterIdle",
      "line": 10,
      "text": "只要结实？那花样就由我挑了。到时候嫌难看，我可不退。",
      "speaker": "薇蕾娜",
      "overflow": false
    },
    {
      "width": 1440,
      "id": "c1SupplyIntro",
      "line": 0,
      "text": "要备点药吗？疗伤的、提神的都有。旁边那台装置也能配药，带着药用精粹就能用。",
      "speaker": "商人",
      "overflow": false
    },
    {
      "width": 1440,
      "id": "c1TrialReport",
      "line": 6,
      "text": "嗯。账本翻了半天，还是这一页。你倒好，进门只顾着跟我说盾有多硬。",
      "speaker": "薇蕾娜",
      "overflow": false
    },
    {
      "width": 844,
      "id": "c1TrialInvitation",
      "line": 9,
      "text": "找鲁恩吧，试炼的事他会帮你安排。",
