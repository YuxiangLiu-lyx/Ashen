      "excerpts": [
        {
          "line": 1,
          "text": "import {footRadiusV281} from './presentation-metrics-v281.js';",
          "truncated": false
        },
        {
          "line": 2,
          "text": "export const validFootBoxV281=b=>Array.isArray(b)&&b.length===4&&b.every(Number.isFinite)&&b[2]>0&&b[3]>0;",
          "truncated": false
        },
        {
          "line": 3,
          "text": "export function pointInFootBoxV281(x,y,b,pad=0){return validFootBoxV281(b)&&x>b[0]-pad&&x<b[0]+b[2]+pad&&y>b[1]-pad&&y<b[1]+b[3]+pad;}",
          "truncated": false
        },
        {
          "line": 4,
          "text": "export function segmentFootBoxV281(a,b,box,pad=0){",
          "truncated": false
        },
        {
          "line": 5,
          "text": " if(!validFootBoxV281(box))return false;let lo=0,hi=1;",
          "truncated": false
        },
        {
          "line": 6,
          "text": " for(const [p,d,mn,mx]of [[a.x,b.x-a.x,box[0]-pad,box[0]+box[2]+pad],[a.y,b.y-a.y,box[1]-pad,box[1]+box[3]+pad]]){",
          "truncated": false
        },
        {
          "line": 7,
          "text": "  if(Math.abs(d)<1e-9){if(p<=mn||p>=mx)return false;continue;}",
          "truncated": false
        },
        {
          "line": 8,
          "text": "  const u=(mn-p)/d,v=(mx-p)/d;lo=Math.max(lo,Math.min(u,v));hi=Math.min(hi,Math.max(u,v));if(lo>=hi)return false;",
          "truncated": false
        }
      ],
